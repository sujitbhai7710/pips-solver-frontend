---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatsCharts from '../components/stats/StatsCharts.svelte';

export const prerender = true;

let statsData = null;
try {
  const res = await fetch('https://pips-worker.pipssolver.workers.dev/stats');
  if (res.ok) statsData = await res.json();
} catch {}
---

<BaseLayout title="Statistics" description="Analytics and insights about NYT Pips puzzles — region types, difficulty distribution, and more.">

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-gray-900 dark:text-gray-100 font-medium">Statistics</span>
    </nav>

    <!-- Header -->
    <div class="mb-8 animate-fade-up">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-2">Puzzle Statistics</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">Analytics and insights about Pips puzzles.</p>
    </div>

    <!-- Stats Overview Cards -->
    {statsData && (
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8 animate-fade-up">
        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-5 text-center">
          <p class="text-2xl sm:text-3xl font-extrabold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
            {statsData.totalPuzzles ?? '—'}
          </p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Total Puzzles</p>
        </div>
        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-5 text-center">
          <p class="text-2xl sm:text-3xl font-extrabold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
            {statsData.editors?.length ?? '—'}
          </p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Editors</p>
        </div>
        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-5 text-center">
          <p class="text-2xl sm:text-3xl font-extrabold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
            {statsData.idRange ? `${statsData.idRange.max - statsData.idRange.min + 1}` : '—'}
          </p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Puzzle IDs</p>
        </div>
        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-5 text-center">
          <p class="text-2xl sm:text-3xl font-extrabold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
            {statsData.recentAdditions?.last7Days ?? '—'}
          </p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Added This Week</p>
        </div>
      </div>
    )}

    <!-- Charts Island -->
    <div class="animate-fade-up delay-100">
      <StatsCharts client:visible />
    </div>

    <!-- Fallback if no data -->
    {!statsData && (
      <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-8 sm:p-12 text-center">
        <svg class="w-16 h-16 mx-auto mb-4 text-gray-300 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
        </svg>
        <h2 class="text-xl font-semibold mb-2 text-gray-900 dark:text-gray-100">Statistics Unavailable</h2>
        <p class="text-gray-500 dark:text-gray-400 mb-6">We couldn't load the statistics data. Please try again later.</p>
        <button
          onclick="window.location.reload()"
          class="px-6 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors"
        >
          Retry
        </button>
      </div>
    )}
  </div>

</BaseLayout>
