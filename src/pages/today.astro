---
import BaseLayout from '../layouts/BaseLayout.astro';
import PuzzleCard from '../components/puzzle/PuzzleCard.svelte';

export const prerender = true;

let puzzleData = null;
try {
  const res = await fetch('https://pips-worker.pipssolver.workers.dev/today');
  if (res.ok) puzzleData = await res.json();
} catch {}

const today = new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
const yesterday = new Date(Date.now() - 86400000).toISOString().split('T')[0];
const tomorrow = new Date(Date.now() + 86400000).toISOString().split('T')[0];
---

<BaseLayout title="Today's Puzzle" description="View today's NYT Pips puzzle with hints, solutions, and AI-powered explanations.">

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-gray-900 dark:text-gray-100 font-medium">Today's Puzzle</span>
    </nav>

    <!-- Date Header & Navigation -->
    <div class="flex items-center justify-between mb-8">
      <a
        href={`/today?date=${yesterday}`}
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        aria-label="Previous day"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Previous
      </a>

      <div class="text-center">
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100">Today's Puzzle</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">{today}</p>
      </div>

      <a
        href={`/today?date=${tomorrow}`}
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        aria-label="Next day"
      >
        Next
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Puzzle Card Island -->
    {puzzleData ? (
      <div class="animate-fade-up">
        <PuzzleCard data={puzzleData} client:load />
      </div>
    ) : (
      <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-8 sm:p-12 text-center">
        <svg class="w-16 h-16 mx-auto mb-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
        <h2 class="text-xl font-semibold mb-2 text-gray-900 dark:text-gray-100">Unable to Load Puzzle</h2>
        <p class="text-gray-500 dark:text-gray-400 mb-6">We couldn't fetch today's puzzle. Please try again later.</p>
        <button
          onclick="window.location.reload()"
          class="px-6 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors"
        >
          Try Again
        </button>
      </div>
    )}

    <!-- Quick Links -->
    <div class="mt-10 grid sm:grid-cols-3 gap-4">
      <a href="/archive" class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-4 flex items-center gap-3 hover:shadow-md transition-shadow group">
        <div class="w-10 h-10 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <p class="font-medium text-sm group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Browse Archive</p>
          <p class="text-xs text-gray-500 dark:text-gray-400">Past puzzles</p>
        </div>
      </a>
      <a href="/stats" class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-4 flex items-center gap-3 hover:shadow-md transition-shadow group">
        <div class="w-10 h-10 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <div>
          <p class="font-medium text-sm group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">View Stats</p>
          <p class="text-xs text-gray-500 dark:text-gray-400">Puzzle analytics</p>
        </div>
      </a>
      <a href="/pips/unlimited" class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-4 flex items-center gap-3 hover:shadow-md transition-shadow group">
        <div class="w-10 h-10 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <p class="font-medium text-sm group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">Play Game</p>
          <p class="text-xs text-gray-500 dark:text-gray-400">Unlimited puzzles</p>
        </div>
      </a>
    </div>
  </div>

</BaseLayout>
