---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameBoard from '../../components/game/GameBoard.svelte';

export const prerender = false;

let puzzleData = null;
try {
  const res = await fetch('https://pips-worker.pipssolver.workers.dev/pips/unlimited');
  if (res.ok) puzzleData = await res.json();
} catch {}
---

<BaseLayout title="Unlimited Pips Game" description="Play unlimited randomly generated Pips puzzles. Drag dominoes onto the grid and validate regions.">

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-gray-900 dark:text-gray-100 font-medium">Unlimited Game</span>
    </nav>

    <!-- Header -->
    <div class="mb-8 animate-fade-up">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-2">Unlimited Pips Game</h1>
          <p class="text-lg text-gray-600 dark:text-gray-400">Practice with randomly generated puzzles. Drag dominoes onto the grid and validate regions.</p>
        </div>
        <button
          onclick="window.location.reload()"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white font-semibold transition-all shadow-lg shadow-blue-600/25 hover:shadow-xl flex-shrink-0"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          New Puzzle
        </button>
      </div>
    </div>

    <!-- Game Board Island -->
    {puzzleData ? (
      <div class="animate-fade-up delay-100">
        <GameBoard puzzleData={puzzleData} client:load />
      </div>
    ) : (
      <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-8 sm:p-12 text-center animate-fade-up">
        <!-- Loading skeleton -->
        <div class="animate-pulse space-y-6 max-w-md mx-auto">
          <div class="h-8 bg-gray-200 dark:bg-gray-700 rounded-lg w-1/3 mx-auto"></div>
          <div class="grid grid-cols-4 gap-2">
            {Array(16).fill(null).map(() => (
              <div class="aspect-square bg-gray-200 dark:bg-gray-700 rounded-md"></div>
            ))}
          </div>
          <div class="h-6 bg-gray-200 dark:bg-gray-700 rounded w-1/2 mx-auto"></div>
          <p class="text-gray-500 dark:text-gray-400 text-sm mt-4">Loading a random puzzle…</p>
        </div>
      </div>
    )}

    <!-- Tips Card -->
    <div class="mt-8 bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 p-5 animate-fade-up delay-200">
      <h3 class="font-semibold mb-3 flex items-center gap-2 text-gray-900 dark:text-gray-100">
        <svg class="w-5 h-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
        </svg>
        Game Tips
      </h3>
      <div class="grid sm:grid-cols-2 gap-4 text-sm text-gray-600 dark:text-gray-400">
        <div class="flex gap-2.5">
          <span class="flex-shrink-0 w-5 h-5 rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 text-xs font-bold flex items-center justify-center">1</span>
          <span>Start with regions that have the fewest possible placements — they constrain the rest of the grid.</span>
        </div>
        <div class="flex gap-2.5">
          <span class="flex-shrink-0 w-5 h-5 rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 text-xs font-bold flex items-center justify-center">2</span>
          <span>Equals (=) regions are the easiest to solve — look for them first to anchor your solution.</span>
        </div>
        <div class="flex gap-2.5">
          <span class="flex-shrink-0 w-5 h-5 rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 text-xs font-bold flex items-center justify-center">3</span>
          <span>Use the sum (Σ) regions to narrow down possible domino placements early in the solve.</span>
        </div>
        <div class="flex gap-2.5">
          <span class="flex-shrink-0 w-5 h-5 rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 text-xs font-bold flex items-center justify-center">4</span>
          <span>Click "New Puzzle" anytime to get a fresh random puzzle and keep practicing.</span>
        </div>
      </div>
    </div>
  </div>

</BaseLayout>
